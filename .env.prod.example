# Copiar a `.env` en el servidor (NUNCA commitees un .env real).
# Se leen pot docker-compose.yml via ${VAR:-default}.
APP_NAME=TechDebt Radar
DEBUG=false
REQUIRE_SQLITE_READY=true

# Prod por defecto usa la red interna; no es necesario ALLOWED_ORIGINS por el
# proxy same-origin, salvo que quieras llamar a la API desde otro dominio.
# ALLOWED_ORIGINS=https://tu-dominio.com

# Ajustar la carga; el free tier tiene poca RAM.
RATE_LIMIT_PER_MINUTE=10
MAX_IN_FLIGHT_JOBS=2
MAX_REPO_SIZE_MB=200
CLONE_DEPTH=50
CLONE_TIMEOUT_SECONDS=120
LS_REMOTE_TIMEOUT_SECONDS=20