# Backend (FastAPI)
APP_NAME=TechDebt Radar
DEBUG=false
DATABASE_URL=sqlite:////app/data/radar.db
REDIS_URL=redis://redis:6379/0
REPO_STORAGE_DIR=/app/data/repos
MAX_REPO_SIZE_MB=200
CLONE_DEPTH=50
CLONE_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=5
MAX_IN_FLIGHT_JOBS=3
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost:3000
REQUIRE_SQLITE_READY=true